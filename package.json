{
  "name": "@skylerfee/dsh-llm-opencode-go-live",
  "version": "0.1.0-alpha.5",
  "description": "OpenCode Go 动态模型目录插件",
  "license": "MIT",
  "author": "SkylerFee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkylerFee/dsh-llm-opencode-go-live.git"
  },
  "bugs": {
    "url": "https://github.com/SkylerFee/dsh-llm-opencode-go-live/issues"
  },
  "homepage": "https://github.com/SkylerFee/dsh-llm-opencode-go-live#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "opencode-go",
    "models.dev",
    "llm",
    "plugin"
  ],
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "docs/*.md",
    "client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.spec.ts",
    "check": "pnpm run build && pnpm run test",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-credentials": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1",
    "@earendil-works/pi-ai": "^0.87.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "@opencode-ai/models": "^0.0.68"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@earendil-works/pi-ai": "0.87.1",
    "@types/node": "^22.20.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
