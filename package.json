{
  "name": "@deepseek-ai/dsh-llm-opencode-go-live",
  "version": "0.1.0-alpha.1",
  "description": "OpenCode Go 动态模型目录插件",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.spec.ts",
    "check": "pnpm run build && pnpm run test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.6-alpha.2"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@opencode-ai/models": "^0.0.68"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
